# Generated by `node build.mjs`. Regenerate rather than commit — rules.json is
# the source of truth, and a stale dist/ in git is a stale site waiting to ship.
dist/

# Internal artefacts: the pitch deck. Deliberately outside dist/ so it can never
# be published to preflight.4xs.dev by accident.
build/

# Bench evidence from probe-q1.sh. Kept OUT of git on purpose: these files contain
# LAN addresses and the full installed-application list of real cameras, including
# unreleased work. If this repo is ever public, that is a leak.
# `git add -f probe-<host>.json` if you decide a specific capture belongs in history.
probe-*.json
probe-*.txt

# Sample customer report — same reason: it names real applications on a real fleet.
preflight-report-*.pdf

# Terminal screenshots of real scans, same reason.
Terminal-Report-*.png

# Scratch
Claude outputs/
node_modules/

# macOS Finder metadata
.DS_Store
._*
.Spotlight-V100
.Trashes

# Signing keys. The private half must never be committed — losing control of it
# means anyone can mint licences; losing the key itself means every existing
# customer key stops verifying and the ACAP must be rebuilt. Keep it where you keep
# passwords, not here. *.pub is safe and IS committed: it only verifies.
*.pem
*.key
.preflight/
signing*

# ACAP build output. The .eap bundles a Node runtime — 30 MB per package, and
# build-<arch>/ is another 109 MB including the ARM node binary. Rebuild with
# `sh build.sh arm64`; do not carry binaries in git.
acap/build-*/
acap/*.eap

# The public licence key IS meant to be committed — it verifies and cannot sign —
# but only a real one. A failed `openssl pkey` leaves a zero-byte file behind.
!acap/app/src/licence-key.pub
