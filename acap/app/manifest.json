{
  "schemaVersion": "1.7.4",
  "acapPackageConf": {
    "setup": {
      "appName": "preflight",
      "friendlyName": "Preflight",
      "vendor": "kotyza@gmail.com",
      "version": "0.8.0",
      "architecture": "aarch64",
      "runMode": "respawn",
      "vendorUrl": "https://preflight.4xs.dev"
    },
    "configuration": {
      "settingPage": "index.html",
      "reverseProxy": [
        {
          "apiPath": "status",
          "target": "http://localhost:32554/",
          "access": "admin"
        },
        {
          "apiPath": "settings",
          "target": "http://localhost:32554/",
          "access": "admin"
        },
        {
          "apiPath": "scan",
          "target": "http://localhost:32554/",
          "access": "admin"
        },
        {
          "apiPath": "results",
          "target": "http://localhost:32554/",
          "access": "admin"
        },
        {
          "apiPath": "report",
          "target": "http://localhost:32554/",
          "access": "admin"
        },
        {
          "apiPath": "recheck",
          "target": "http://localhost:32554/",
          "access": "admin"
        }
      ]
    }
  }
}
